{
  "hosting": {
    "public": "website/dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      {
        "source": "/api/**",
        "run": { "serviceId": "alarmi-api", "region": "us-east1" }
      },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
